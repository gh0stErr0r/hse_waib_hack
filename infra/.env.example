# Generate infra/.env with node scripts/setup-gastro.mjs.
# Load explicitly with docker compose --env-file infra/.env -f infra/docker-compose.gastro.yml.
# Server-side API keys are passed only to engine; JWT keys only to auth.
POSTGRES_PASSWORD=replace-with-a-long-random-password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional legacy Yandex adapters only. Leave empty for the default Gemini/OSM stack.
YANDEX_SEARCH_KEY=
YANDEX_GEOCODER_KEY=
VITE_YANDEX_MAPS_KEY=
ALLOWED_ORIGINS=http://localhost:8088
# Go Auth supports persistent matching base64 Ed25519 keys.
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
PEPPER=
SMTP_USER=
SMTP_PASSWORD=
# Explicitly enables synthetic places; still uses Gemini and real account auth.
DEMO_PLACES=false
# Optional contracted data provider, including licensed event feed.
PLACE_ENRICHMENT_URL=
PLACE_ENRICHMENT_TOKEN=
# Default live stack: Google Search through Gemini. No map provider is used in the UI.
GEMINI_API_MODE=interactions
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
PLACES_PROVIDER=gemini
GEOCODER_URL=https://photon.komoot.io/api/
# Optional Linux host-network SMTP workaround when Docker bridge has no usable route.
SMTP_NETWORK=tcp
SMTP_TIMEOUT=20s
SMTP_HOST_NETWORK=false
SMTP_NATS_HOST_PORT=14222

# Gmail transport: 587/starttls by default; 465/tls is an alternative.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls

# Optional per-container DNS override for engine and notif.
APP_CUSTOM_DNS=false
APP_DNS_PRIMARY=1.1.1.1
APP_DNS_SECONDARY=8.8.8.8
