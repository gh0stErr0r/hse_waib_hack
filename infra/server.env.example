# Replace registry.gitlab.example/group/template and the commit tag before use.
AUTH_IMAGE=registry.gitlab.example/group/template/auth:commit-sha
CORE_IMAGE=registry.gitlab.example/group/template/core:commit-sha
NOTIF_IMAGE=registry.gitlab.example/group/template/notif:commit-sha
AGENT_IMAGE=registry.gitlab.example/group/template/agent:commit-sha

# Optional SMTP credentials; empty values enable the local mail stub.
SMTP_USER=
SMTP_PASSWORD=

# Matching base64 Ed25519 keys; empty values generate ephemeral keys.
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
